{
  "name": "todo-just",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:all": "npm run build && npm run build:firefox",
    "check": "npm run typecheck && npm run test && npm run build:all",
    "check:locales": "uv run python scripts/check-locales.py",
    "package": "npm run build:all && uv run python scripts/package.py"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0"
  }
}
